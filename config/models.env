# Public model/runtime configuration. Safe to commit.
#
# Put API keys and tokens only in:
# models/<provider>/secrets/.env
#
# Competition versions are pinned by metadata.model_roster and
# config/model_rosters/. models/<provider>/versions.py is the fallback only
# when no competition cohort is selected.
# Override here only when you intentionally need a provider-supported
# non-default version for an ad hoc run. Keep committed defaults on the
# strongest active benchmark models.
# OPENAI_MODEL=gpt-6-astra
# ANTHROPIC_MODEL=claude-fable-5-1
# GEMINI_MODEL=gemini-4-argon
# GIGACHAT_MODEL=GigaChat-3-Ultra
# XAI_MODEL=grok-4.7
# ZAI_MODEL=glm-5.3
# KIMI_MODEL=kimi-k3.1-pro
# YANDEX_MODEL=aliceai-llm
# DEEPSEEK_MODEL=deepseek-flash

# Default runner model set. "all" expands to the selected competition's exact
# cohort, matching its scoring columns; unassigned competitions use VERSIONS.
RUNNER_MODELS=all

# Benchmark reasoning/output budgets. These are not secrets.
# Every official run requests this same total output budget. GigaChat and Alice
# use explicit operational caps (8192 and 8000), recorded separately from the request.
RUNNER_MAX_TOKENS=256000

OPENAI_REASONING_EFFORT=high
OPENAI_MAX_COMPLETION_TOKENS=128000

ANTHROPIC_MAX_TOKENS=128000
ANTHROPIC_THINKING_BUDGET_TOKENS=60000
ANTHROPIC_FINAL_TOKEN_RESERVE=4096
ANTHROPIC_EFFORT=max

GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_VERIFY_SSL=false
GIGACHAT_TEMPERATURE=0.1
GIGACHAT_TOP_P=1.0
GIGACHAT_MAX_TOKENS=8192
GIGACHAT_REPETITION_PENALTY=1.0
# The SDK default is 30 seconds, which is insufficient for reasoning runs.
GIGACHAT_TIMEOUT=7200
GIGACHAT_MAX_RETRIES=3
GIGACHAT_RETRY_BACKOFF_FACTOR=2

YANDEX_TEMPERATURE=0.1
YANDEX_MAX_TOKENS=8000
YANDEX_TIMEOUT=900
YANDEX_REASONING_MODE=ENABLED_HIDDEN

RUB_PER_USD=90

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEMPERATURE=0.1
DEEPSEEK_REASONING_EFFORT=max
DEEPSEEK_TIMEOUT_SECONDS=7200
DEEPSEEK_MAX_RETRIES=0
DEEPSEEK_MAX_TOKENS=256000

GEMINI_THINKING_LEVEL=high
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=128000
GEMINI_TIMEOUT_SECONDS=7200

XAI_BASE_URL=https://api.x.ai/v1
XAI_REASONING_EFFORT=high
XAI_MAX_OUTPUT_TOKENS=128000
XAI_TIMEOUT_SECONDS=7200
XAI_MAX_RETRIES=0

ZAI_BASE_URL=https://api.z.ai/api/paas/v4/
ZAI_THINKING=enabled
ZAI_REASONING_EFFORT=max
ZAI_TEMPERATURE=0.1
ZAI_MAX_TOKENS=256000
ZAI_TIMEOUT_SECONDS=7200
ZAI_MAX_RETRIES=0

KIMI_BASE_URL=https://api.moonshot.ai/v1
# Legacy K3 accepts temperature=1; K3.1 Pro omits temperature/top_p.
KIMI_TEMPERATURE=1
KIMI_REASONING_EFFORT=max
KIMI_MAX_TOKENS=256000
KIMI_TIMEOUT_SECONDS=7200
