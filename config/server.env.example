# Copy this file to config/server.env and fill your private server settings.
# config/server.env is gitignored.

SCORER_REMOTE_LOGS=user@host:/absolute/path/to/shared/logs/
# Optional. Needed when the server stores scoring sidecar files separately.
# SCORER_REMOTE_RESULTS=user@host:/absolute/path/to/data/results/
# SCORER_SSH_PORT=22

# Optional production inventory for operators and deployment tooling. Public
# URLs may be recorded here; keep usernames, private hosts and machine paths in
# the gitignored config/server.env only.
SCORER_PUBLIC_URL=https://scorer.example.com/
PUBLIC_RESULTS_URL=https://results.example.com/
PUBLIC_RESULTS_S3_URI=s3://public-results-bucket/
PUBLIC_RESULTS_STAGING_DIR=/absolute/private/path/to/public-site

# Scoring web auth/session settings. Fill SCORER_SECRET_KEY on the server with
# a private value, for example from:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SCORER_SECRET_KEY=
SCORER_AUTH_DB=
SCORER_COOKIE_SECURE=1
SCORER_SESSION_HOURS=12
